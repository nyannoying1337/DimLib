{
	"schemaVersion": 1,
	"id": "dimlib",
	"version": "${version}",
	"name": "DimLib (Unofficial 26.3 Port)",
	"description": "Adds the functionality of dynamically adding and removing dimensions.\nAlso allow disabling 'Experimental Settings not supported' warning screen.",
	"authors": [
		"qouteall"
	],
	"contact": {
		"homepage": "https://github.com/${github_repo}",
		"sources": "https://github.com/${github_repo}",
		"issues": "https://github.com/${github_repo}/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/dimlib/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "qouteall.dimlib.DimLibEntry"
		],
		"client": [
			"qouteall.dimlib.DimLibEntryClient"
		],
		"modmenu": [
			"qouteall.dimlib.config.DimLibModmenuIntegration"
		]
	},
	"mixins": [
		"dimlib.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ["26.3"],
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {

	},
	"custom": {
		"modmenu": {
			"badges": ["library"]
		}
	}
}